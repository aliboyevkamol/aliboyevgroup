APP_ENV=development
APP_PORT=8080

# Docker Compose builds DATABASE_URL itself; set it when running the binary directly.
DATABASE_URL=postgres://kamol:kamol@localhost:5432/kamol?sslmode=disable
POSTGRES_USER=kamol
POSTGRES_PASSWORD=kamol
POSTGRES_DB=kamol

# Random values, at least 32 characters (openssl rand -hex 32). Required in production.
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me
PAYMENT_WEBHOOK_SECRET=change_me

# Allowed browser origin(s) for CORS, comma separated. Not needed when the backend serves the site (STATIC_DIR).
FRONTEND_URL=http://localhost:5500
# Public base URL of this API (used in signed file URLs)
PUBLIC_URL=http://localhost:8080
# Optional: serve the website from this folder (whitelisted file types only)
STATIC_DIR=

STORAGE_DRIVER=local
STORAGE_PATH=./uploads

# "test" is the development provider (never allowed when APP_ENV=production).
PAYMENT_PROVIDER=test

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

# Optional: create the first admin at start-up when no admin exists (min 12 chars). Remove afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

AUTO_MIGRATE=true
AUTO_SEED=true
TRUST_PROXY=false
RATE_AUTH_PER_MIN=20
RATE_AUTH_BURST=10
RATE_API_PER_MIN=600
RATE_API_BURST=200
